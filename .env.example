export MONGO_URI=MONGO_URI
export MONGO_DATABASE=main
# Comma-separated list of public frontend origins to merge into the CORS allow-list.
# Example: export FRONTEND_ORIGIN=https://hatyai-flood.example.com,https://staging.example.com
export FRONTEND_ORIGIN=
export HFT_RISK_RAINFALL_1H_YELLOW_MM=25
export HFT_RISK_RAINFALL_1H_ORANGE_MM=40
export HFT_RISK_RAINFALL_1H_RED_MM=60
export HFT_RISK_RAINFALL_3H_YELLOW_MM=40
export HFT_RISK_RAINFALL_3H_ORANGE_MM=70
export HFT_RISK_RAINFALL_3H_RED_MM=100
export HFT_RISK_RAINFALL_6H_YELLOW_MM=60
export HFT_RISK_RAINFALL_6H_ORANGE_MM=100
export HFT_RISK_RAINFALL_6H_RED_MM=150
export HFT_RISK_RAINFALL_24H_YELLOW_MM=80
export HFT_RISK_RAINFALL_24H_ORANGE_MM=130
export HFT_RISK_RAINFALL_24H_RED_MM=200
export HFT_RISK_RAINFALL_48H_YELLOW_MM=120
export HFT_RISK_RAINFALL_48H_ORANGE_MM=200
export HFT_RISK_RAINFALL_48H_RED_MM=300
export HFT_RISK_RAINFALL_72H_YELLOW_MM=160
export HFT_RISK_RAINFALL_72H_ORANGE_MM=250
export HFT_RISK_RAINFALL_72H_RED_MM=350
export HFT_RISK_FRESH_RUN_MAX_AGE_HOURS=12
export HFT_RISK_AGING_RUN_MAX_AGE_HOURS=18
export HFT_RISK_EXPECTED_FORECAST_CELLS=2
export HFT_RISK_EXPECTED_WATER_STATIONS=2
export HFT_RISK_MINIMUM_COVERAGE_RATIO=0.6
export HFT_RISK_WATER_WATCH_RATIO=0.8
export HFT_RISK_WATER_STATION_MAX_AGE_HOURS=3
export HFT_RISK_ALLOW_MOCK_WATER_LEVEL_RAISE=false
# Forecast repository selection: 'dry_run' keeps everything in memory, 'mongo' persists
# runs and frames into MongoDB via the MongoForecastRepository.
# On Cloud Run, both the api service and the gfs-ingest Cloud Run Job should set this to
# 'mongo' so scheduled runs (00/06/12/18 UTC, see deploy/gfs-ingest-job.yaml) persist into
# the same database that /api/forecast/frames and /api/freshness read.
export HFT_FORECAST_REPOSITORY_BACKEND=dry_run
export HFT_MONGODB_URI=mongodb://localhost:27017
export HFT_MONGODB_DATABASE=hatyai_flood_warning
# LINE Notify push alerts (HFT-30). LINE_NOTIFY_TOKEN is the channel access token; leave it
# empty to disable sending (the dispatcher logs a warning instead of erroring). Never commit a
# real token. The dispatcher fires only on an upward risk transition to orange/red, with a
# cooldown (hours) that a further upward transition bypasses.
export LINE_NOTIFY_TOKEN=
export HFT_LINE_NOTIFY_COOLDOWN_HOURS=3
export HFT_LINE_NOTIFY_DASHBOARD_URL=https://hatyai-flood-warning.vercel.app
# Static bearer token protecting POST /api/alerts/test. Empty rejects every request.
export ALERTS_TEST_TOKEN=
# Web Push / PWA alerts (HFT-32). Generate keys with
# `uv run python scripts/generate_vapid_keys.py` and store them as secrets — never commit.
# Leave VAPID_PRIVATE_KEY empty to disable Web Push (the dispatcher logs a warning instead of
# erroring). VAPID_PUBLIC_KEY is non-secret: it is served by GET /api/alerts/vapid-public-key
# and used by the browser as the applicationServerKey.
export VAPID_PRIVATE_KEY=
export VAPID_PUBLIC_KEY=
export HFT_VAPID_SUBJECT=mailto:admin@hatyai-flood.example.com
# Citizen flood reports (HFT-73). REPORTS_MODERATION_TOKEN is a static bearer token protecting
# the moderation endpoints (list pending, approve, reject). Empty rejects every moderation
# request, mirroring ALERTS_TEST_TOKEN. Never commit a real token.
export REPORTS_MODERATION_TOKEN=
# Maximum reports a single submitter IP may file per rolling hour (Mongo-backed counter keyed on
# a salted hash of the IP; the raw IP is never stored).
export HFT_REPORTS_RATE_LIMIT_PER_HOUR=5
# Salt mixed into the SHA-256 hash of the submitter IP used as the rate-limit key. Set a
# deployment-specific value so keys cannot be precomputed. The raw IP is never persisted.
export HFT_REPORTS_IP_HASH_SALT=hatyai-flood-reports